# Copy this file to .env.local and fill in real values before deploying.

# Password to log into /admin — CHANGE THIS before going live.
ADMIN_PASSWORD=changeme123

# Random long string used to sign admin session cookies.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-string

# --- Payment gateway (fill in whichever one you integrate in lib/payment.js) ---
# ABA_MERCHANT_ID=
# ABA_API_KEY=
# BAKONG_ACCOUNT_ID=
# BAKONG_API_KEY=
# WING_API_KEY=

# --- Diamond supplier / reseller (fill in for lib/supplier.js) ---
# SUPPLIER_API_KEY=
# SUPPLIER_BASE_URL=

# --- Telegram order notifications (see lib/telegram.js for setup steps) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
